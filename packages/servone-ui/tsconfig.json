{
  "extends": "./node_modules/@hcengineering/platform-rig/profiles/ui/tsconfig.json",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "declarationDir": "./types",
    // shadcn-svelte output imports `$lib/utils.js`; `moduleResolution: node` can't map .js -> .ts.
    // Runtime alias lives in dev/prod/webpack.config.js.
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "$lib": ["./src/lib"],
      "$lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/**/*"],
  // src/plugins/** resolve imports from upstream plugin dirs via webpack only; tsc can't follow,
  // so they are type-checked through their upstream originals.
  "exclude": ["node_modules", "lib", "dist", "types", "bundle", "src/plugins"]
}
